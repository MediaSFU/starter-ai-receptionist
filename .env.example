# From https://mediasfu.com/api-keys (server-side only).
MEDIASFU_API_USERNAME=
MEDIASFU_API_KEY=
# Must match the "secure code" (or webhook auth token) on your number's SIP config. 8+ characters.
CALL_WEBHOOK_TOKEN=
# Password for the calls dashboard (any username). 8+ characters.
DASHBOARD_PASSWORD=
# Optional: where each finished call is sent (n8n Webhook node, Make, Zapier catch hook, CRM).
FORWARD_WEBHOOK_URL=
